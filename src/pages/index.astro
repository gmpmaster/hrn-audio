---
import Base from '../layouts/Base.astro';
import DemoPlayer from '../components/DemoPlayer.astro';
import shows from '../data/shows.json';

const talent = [...shows].sort((a, b) => a.order - b.order);

const socialIcon: Record<string, string> = {
  instagram: 'M12 2.2c3.2 0 3.6 0 4.9.07 3.3.15 4.8 1.7 5 5 .06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.15 3.3-1.7 4.8-5 5-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-3.3-.15-4.8-1.7-5-5C2.04 15.6 2 15.2 2 12s0-3.6.07-4.9c.15-3.3 1.7-4.8 5-5C8.4 2.04 8.8 2 12 2.2zm0 3.1a6.7 6.7 0 100 13.4 6.7 6.7 0 000-13.4zm0 11a4.3 4.3 0 110-8.6 4.3 4.3 0 010 8.6zm6.9-11.3a1.6 1.6 0 11-3.2 0 1.6 1.6 0 013.2 0z',
  facebook: 'M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z',
  tiktok: 'M16.6 5.8a4.8 4.8 0 01-1-2.8h-3.3v13.2a2.8 2.8 0 11-2-2.7V10a6 6 0 102 4.5V9.1a7.9 7.9 0 004.6 1.5V7.3a4.8 4.8 0 01-.3-1.5z',
  youtube: 'M21.6 7.2a2.5 2.5 0 00-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 00-1.8 1.8A26 26 0 002 12a26 26 0 00.4 4.8 2.5 2.5 0 001.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 001.8-1.8A26 26 0 0022 12a26 26 0 00-.4-4.8zM10 15.2V8.8l5.2 3.2-5.2 3.2z',
};

const buy = [
  ['Sponsorships', 'Own a segment, a feature or a tentpole moment, with billboards and named integration.', 'var(--red)'],
  ['Live & host reads', 'The endorsement listeners already trust, read by the voice they trust it from.', 'var(--amber)'],
  ['National spots', ':30 and :60 across the full network. One buy, one report.', 'var(--magenta)'],
  ['Custom networks', 'Station groupings built around a message, a category or a moment.', 'var(--violet)'],
  ['Talent activation', 'Hosts extending a campaign into their own social followings.', 'var(--green)'],
  ['Digital audio', 'Streaming, podcast and companion display, planned by language.', 'var(--cyan)'],
];

const opportunity = [
  ['20%', 'of the U.S. population is Hispanic', ''],
  ['5th', 'largest GDP in the world if U.S. Hispanics were a country', 'Latino Donor Collaborative'],
  ['~11 yrs', 'younger median age than the non-Hispanic white population', 'Pew Research'],
  ['3.6%', 'of U.S. ad spend goes to Hispanic media', 'ANA / AIMM'],
];
---

<Base
  title="HRN Audio — Hear the shows Hispanic radio actually plays"
  description="Nationally syndicated Hispanic radio from HRN Media Networks. Hear Ana María Canseco, El Patrón, DJ Xtreme, Los 40 USA and Juan Arango."
>

  <!-- ============================== HERO ============================== -->
  <header class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="hero-eyebrow">HRN Media Networks</p>
        <h1>These are the voices<br />Hispanic America<br /><span class="hl">turns on.</span></h1>
        <p class="hero-lede">
          The hosts they wake up to, drive home with, and turn up.
          Don't take our word for how they sound.
        </p>
        <div class="btn-row">
          <a href="#talent" class="btn btn-white">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            Hear them
          </a>
          <a href="#contact" class="btn btn-outline">Request a plan</a>
        </div>
      </div>
      <div class="hero-img">
        <img src="/img/lineup.webp" width="2000" height="1167" fetchpriority="high"
             alt="HRN on-air talent" />
      </div>
    </div>
  </header>

  <!-- ============================= TALENT ============================= -->
  <section id="talent">
    <div class="wrap center">
      <p class="eyebrow">The talent</p>
      <h2>Press play.</h2>
      <p class="lede" style="margin-top:16px">
        Every other audio network asks you to take reach on faith. Here is what the
        programming actually sounds like.
      </p>
    </div>

    <div class="wrap t-grid">
      {talent.map((t) => (
        <article class="tc" style={`--c:${t.accent};--ct:${t.accentText ?? t.accent};--c2:${t.accent2 ?? t.accent};--panel:${t.panel ?? t.accent}`}>
          <div class:list={['tc-art', { branded: !!t.cutout }]}>
            {t.cutout ? (
              <>
                <img class="tc-cut" src={t.cutout} alt={t.host} loading="lazy" />
                {t.logo && <img class="tc-logo" src={t.logo} alt={`${t.show} logo`} loading="lazy" />}
              </>
            ) : (
              <img src={t.photo} alt={`${t.show} with ${t.host}`} loading="lazy" width="1000" height="1000" />
            )}
            <DemoPlayer src={t.audio} label={`${t.show} with ${t.host}`} accent={t.accent} compact unavailable={!t.hasDemo} />
          </div>

          <div class="tc-body">
            <p class="tc-kicker">{t.credential}</p>
            <h3 class="tc-show">{t.show}</h3>
            <p class="tc-host">{t.host}</p>

            <div class="tc-stats">
              {t.cardStats.map((s) => (
                <div>
                  <span class="sv">{s.needs ? '—' : s.value}</span>
                  <span class="sl">{s.label}{s.needs && <span class="flag">Need</span>}</span>
                </div>
              ))}
            </div>

            <div class="tc-social" data-needs-content="socials">
              {t.socials.map((s) => (
                <a class:list={['soc', { off: !s.url }]} href={s.url || undefined}
                   target={s.url ? '_blank' : undefined} rel={s.url ? 'noopener noreferrer' : undefined}
                   title={s.url ? `${t.host} on ${s.net}` : `${s.net} handle needed`}
                   aria-label={s.url ? `${t.host} on ${s.net}` : `${s.net} handle needed`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={socialIcon[s.net]} /></svg>
                  <em>{s.followers || '—'}</em>
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}

      <!-- the sixth cell: everything not featured here -->
      <a class="tc tc-more" href="/shows">
        <span class="more-i" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </span>
        <h3>And there's more where they came from.</h3>
        <p>Tejano Nation, Minuto 60, La Mezcla and the full 24/7 format lineup — with demos.</p>
        <span class="more-cta">See all programming →</span>
      </a>
    </div>
  </section>

  <!-- ============================ NETWORK ============================= -->
  <section id="network" class="on-dark net">
    <div class="wrap center">
      <p class="eyebrow">The network</p>
      <h2>Stations choose to carry these shows.</h2>
      <p class="lede" style="margin-top:18px">
        HRN represents nationally syndicated Hispanic programming. Affiliates are not bought —
        they opt in, because the shows perform for their audience, and they can drop them the
        moment that stops. A brand inside HRN programming arrives with the station's own
        credibility attached.
      </p>

      <div class="net-strip">
        <div><span class="stat">345</span><span>affiliate stations</span></div>
        <div><span class="stat">95</span><span>markets</span></div>
        <div><span class="stat">95%</span><span>of U.S. Hispanics</span></div>
        <div><span class="stat">#1</span><span>in 14 Hispanic DMAs</span></div>
      </div>
      <p class="src">Ninety cents of every advertising dollar goes back to the affiliate stations, 141 of which are minority-owned.</p>
    </div>
  </section>

  <!-- ============================== BUY =============================== -->
  <section id="buy">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">What you can buy</p>
        <h2>Six ways in.</h2>
      </div>
      <div class="grid g3" style="margin-top:56px">
        {buy.map(([t, d, c]) => <div class="card" style={`--c:${c}`}><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <!-- =========================== OPPORTUNITY ========================== -->
  <section id="opportunity" class="mist">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">The opportunity</p>
        <h2>The audience is growing.<br />The spend isn't.</h2>
        <p class="lede" style="margin-top:18px">
          Hispanic audiences are younger, larger and more brand-loyal than the general
          market — and still dramatically under-invested against.
        </p>
      </div>
      <div class="grid g4 opp">
        {opportunity.map(([v, l, src], i) => (
          <div class="opp-c" style={`--c:${['var(--red)','var(--violet)','var(--green)','var(--amber)'][i]}`}>
            <div class="stat opp-v">{v}</div>
            <p class="opp-l">{l}</p>
            {src && <p class="opp-s">{src}</p>}
          </div>
        ))}
      </div>
      <p class="src center" data-needs-content="sources">
        <span class="flag">Verify</span>
        Figures are drawn from public research and need a final source and date check before launch.
      </p>
    </div>
  </section>

  <!-- ============================= CONTACT ============================ -->
  <section id="contact" class="cta">
    <div class="wrap center">
      <p class="eyebrow">Let's talk</p>
      <h2>Tell us who you need to reach.</h2>
      <p class="lede" style="margin-top:18px">
        We'll come back with the shows, the markets and the measurement — in writing.
      </p>

      <form name="audio-plan" method="POST" data-netlify="true" netlify-honeypot="company-url" class="f">
        <input type="hidden" name="form-name" value="audio-plan" />
        <p class="hp"><label>Do not fill this out: <input name="company-url" /></label></p>
        <div class="f-row">
          <input type="text" name="name" placeholder="Name" required aria-label="Name" />
          <input type="email" name="email" placeholder="Email" required aria-label="Email" />
        </div>
        <div class="f-row">
          <input type="text" name="company" placeholder="Company or agency" aria-label="Company or agency" />
          <input type="tel" name="phone" placeholder="Phone" aria-label="Phone" />
        </div>
        <textarea name="message" placeholder="Who are you trying to reach?" aria-label="Message"></textarea>
        <button type="submit" class="btn btn-primary">Request a plan</button>
      </form>

      <p class="src">Or call <a href="tel:+18882717521">(888) 271-7521</a></p>
    </div>
  </section>
</Base>

<style>
  /* ---------------- hero ---------------- */
  .hero{position:relative;overflow:hidden}
  .hero-bg{position:absolute;inset:0;z-index:0;
    background:
      radial-gradient(900px 620px at 84% 8%, rgba(255,255,255,.34), transparent 60%),
      radial-gradient(760px 620px at 6% 96%, rgba(124,77,255,.55), transparent 66%),
      linear-gradient(118deg,#00A7E2 0%,#1E7FE0 40%,#7C4DFF 76%,#C42BA6 100%);
  }
  .hero-in{position:relative;z-index:1;display:grid;
           grid-template-columns:minmax(330px,.88fr) 1.22fr;gap:10px;align-items:end;min-height:590px}
  .hero-copy{padding:76px 0 88px}
  .hero-eyebrow{font-family:var(--head);font-size:.74rem;font-weight:700;letter-spacing:.2em;
                text-transform:uppercase;color:rgba(255,255,255,.9);margin:0 0 16px}
  .hero h1{color:#fff;margin-bottom:24px;text-shadow:0 2px 26px rgba(10,20,40,.22)}
  .hl{color:#FFE45E}
  .hero-lede{font-size:1.24rem;color:rgba(255,255,255,.95);max-width:40ch;margin:0;font-weight:600}
  .hero-img{align-self:end;margin:0 -80px -1px 0;min-width:0}
  .hero-img img{width:100%;max-width:none;filter:drop-shadow(0 28px 46px rgba(6,20,40,.42))}
  @media(min-width:1500px){.hero-img{margin-right:-140px}}
  @media(max-width:980px){
    .hero-in{grid-template-columns:1fr;min-height:0;gap:0}
    .hero-copy{padding:52px 0 12px;text-align:center}
    .hero-lede{margin:0 auto}
    .hero .btn-row{justify-content:center}
    .hero-img{margin:0 -26px -1px}
  }
  .btn-white{background:#fff;color:var(--ink);border-color:#fff;box-shadow:0 12px 30px -12px rgba(6,20,40,.5)}
  .btn-white:hover{background:#FFE45E;border-color:#FFE45E}
  .btn-outline{background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.6)}
  .btn-outline:hover{background:#fff;color:var(--ink);border-color:#fff}

  /* ---------------- talent grid ---------------- */
  .t-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:58px}
  @media(max-width:1000px){.t-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.t-grid{grid-template-columns:1fr}}

  .tc{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;
      display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s;
      box-shadow:0 1px 3px rgba(14,26,32,.05)}
  .tc:hover{transform:translateY(-5px);box-shadow:0 26px 50px -24px color-mix(in srgb,var(--c) 55%,transparent)}
  .tc-art{position:relative;background:#0E1A20}
  .tc-art > img{width:100%;aspect-ratio:1;object-fit:cover}

  /* branded panel: transparent cutout + show logo on the show's own colour */
  .tc-art.branded{aspect-ratio:1;overflow:hidden;
    background:
      radial-gradient(110% 80% at 78% 4%, color-mix(in srgb, #fff 42%, var(--panel)) 0%, transparent 56%),
      linear-gradient(152deg,
        color-mix(in srgb, var(--panel) 82%, #fff) 0%,
        var(--panel) 52%,
        color-mix(in srgb, var(--c2) 42%, var(--panel)) 100%);
  }
  .tc-art.branded .tc-cut{position:absolute;bottom:0;right:-6%;height:96%;width:auto;
    aspect-ratio:auto;object-fit:contain;object-position:bottom center;
    filter:drop-shadow(0 12px 22px rgba(0,0,0,.3))}
  .tc-art.branded .tc-logo{position:absolute;top:7%;left:6%;width:46%;height:auto;
    aspect-ratio:auto;object-fit:contain;z-index:1;
    filter:drop-shadow(0 4px 10px rgba(0,0,0,.22))}
  .tc-body{padding:22px 22px 24px;display:flex;flex-direction:column;flex:1}

  .tc-kicker{font-family:var(--head);font-size:.66rem;font-weight:700;letter-spacing:.13em;
             text-transform:uppercase;color:var(--ct);margin:0 0 8px;min-height:2.1em;line-height:1.4}
  .tc-show{font-size:1.32rem;font-weight:700;letter-spacing:-.02em;margin-bottom:2px;line-height:1.2}
  .tc-host{font-family:var(--head);font-size:.92rem;color:var(--slate);margin:0 0 16px}

  .tc-stats{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:16px 0;
            border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:14px}
  .tc-stats .sv{display:block;font-family:var(--head);font-weight:700;font-size:1.3rem;
                color:var(--ct);line-height:1.1}
  .tc-stats .sl{font-size:.72rem;color:var(--slate);line-height:1.35;display:block;margin-top:3px}
  .tc-stats .flag{margin-left:5px}

  .tc-social{display:flex;gap:7px;margin-top:auto;flex-wrap:wrap}
  .soc{display:inline-flex;align-items:center;gap:5px;background:var(--mist);border-radius:999px;
       padding:5px 11px 5px 8px;color:var(--slate);text-decoration:none;transition:background .16s,color .16s}
  a.soc:hover{background:var(--c);color:#fff}
  .soc.off{opacity:.45;pointer-events:none}
  .soc svg{width:15px;height:15px;fill:currentColor;flex:0 0 15px}
  .soc em{font-style:normal;font-family:var(--head);font-size:.72rem;font-weight:600;
          font-variant-numeric:tabular-nums}

  /* the sixth cell */
  .tc-more{text-decoration:none;justify-content:center;align-items:flex-start;
           padding:32px 28px;background:linear-gradient(150deg,#0E1A20,#123243);
           border-color:transparent;color:#C8D6DE;gap:0}
  .tc-more:hover{transform:translateY(-5px);box-shadow:0 26px 50px -24px rgba(0,167,226,.55)}
  .more-i{width:46px;height:46px;border-radius:50%;background:var(--cyan);color:#fff;
          display:grid;place-items:center;margin-bottom:20px}
  .more-i svg{width:22px;height:22px;fill:none}
  .tc-more h3{color:#fff;font-size:1.3rem;letter-spacing:-.02em;margin-bottom:10px;line-height:1.24}
  .tc-more p{font-size:.92rem;color:#93A6B2;margin:0 0 18px}
  .more-cta{font-family:var(--head);font-weight:700;font-size:.87rem;color:var(--cyan-br)}

  /* ---------------- network ---------------- */
  .net{background:linear-gradient(140deg,#0E1A20 0%,#123243 58%,#0E1A20 100%)}
  .net-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:48px;
             padding:30px;background:rgba(255,255,255,.05);border-radius:16px;
             border:1px solid rgba(255,255,255,.1)}
  @media(max-width:700px){.net-strip{grid-template-columns:repeat(2,1fr);gap:26px}}
  .net-strip div{display:flex;flex-direction:column;gap:5px}
  .net-strip .stat{font-size:2.15rem;color:var(--cyan-br)}
  .net-strip span:last-child{font-size:.84rem;color:#93A6B2}

  /* ---------------- opportunity ---------------- */
  .opp{margin-top:52px}
  .opp-c{background:#fff;border-radius:14px;padding:28px 24px;border-top:4px solid var(--c)}
  .opp-v{font-size:2.7rem;color:var(--c)}
  .opp-l{font-size:.95rem;color:var(--slate);margin:10px 0 0}
  .opp-s{font-size:.74rem;color:var(--slate-lt);margin:6px 0 0}

  /* ---------------- contact ---------------- */
  .cta{background:linear-gradient(118deg,#00A7E2 0%,#1E7FE0 42%,#7C4DFF 100%)}
  .cta h2{color:#fff}
  .cta .eyebrow{color:rgba(255,255,255,.88)}
  .cta .lede{color:rgba(255,255,255,.93)}
  .f{max-width:560px;margin:38px auto 0;display:grid;gap:14px}
  .f-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  @media(max-width:560px){.f-row{grid-template-columns:1fr}}
  .f input,.f textarea{font-family:var(--body);font-size:1rem;padding:15px 17px;
    border:2px solid rgba(255,255,255,.3);border-radius:10px;background:rgba(255,255,255,.14);
    color:#fff;width:100%}
  .f input::placeholder,.f textarea::placeholder{color:rgba(255,255,255,.72)}
  .f input:focus,.f textarea:focus{outline:none;border-color:#fff;background:rgba(255,255,255,.22)}
  .f textarea{min-height:120px;resize:vertical}
  .f button{justify-self:center;margin-top:6px;background:#fff;color:var(--ink);border-color:#fff}
  .f button:hover{background:#FFE45E;border-color:#FFE45E}
  .hp{position:absolute;left:-9999px}
  .cta .src{color:rgba(255,255,255,.85)}
  .cta .src a{color:#fff;font-weight:700}
</style>
