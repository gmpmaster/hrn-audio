---
/* Demo player. Vanilla — no library.
   compact = button + thin progress bar, sits over show artwork.
   full    = button + waveform, for the programming page.
   Only one plays at a time. Degrades honestly when the mp3 is missing. */
interface Props {
  src: string;
  label: string;
  accent?: string;
  compact?: boolean;
  variant?: string;
  unavailable?: boolean;
}
const { src, label, accent = '#00A7E2', compact = false, variant, unavailable = false } = Astro.props;
---

<div class:list={['player', { compact, missing: unavailable }]} data-player data-unavailable={unavailable ? 'true' : undefined} style={`--accent:${accent}`}>
  <button class="play" type="button" disabled={unavailable} aria-label={unavailable ? `Demo coming soon: ${label}` : `Play demo: ${label}`} data-play>
    <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
    <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
    <svg class="i-load" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
  </button>

  {compact ? (
    <>
      <span class="c-label" data-label>{unavailable ? "Demo coming soon" : "Hear the demo"}</span>
      <span class="time" data-time></span>
      <div class="c-track" data-track></div>
      <div class="c-bar-wrap" aria-hidden="true"><div class="c-bar" data-bar></div></div>
    </>
  ) : (
    <div class="body">
      <div class="top">
        <span class="lbl" data-label>{variant ?? 'Hear the show'}</span>
        <span class="time" data-time>0:00</span>
      </div>
      <div class="track" data-track role="slider" tabindex="0"
           aria-label={`Seek within ${label}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="bar" data-bar></div>
        <div class="wave" aria-hidden="true">
          {Array.from({ length: 44 }).map((_, i) => (
            <span style={`height:${22 + Math.abs(Math.sin(i * 0.9)) * 64 + (i % 4) * 5}%`}></span>
          ))}
        </div>
      </div>
    </div>
  )}

  <audio preload="none" data-audio src={src}></audio>
</div>

<style>
  .play{border:0;cursor:pointer;background:var(--accent);color:var(--play-ink,#fff);
        display:grid;place-items:center;border-radius:50%;flex:0 0 auto;
        transition:transform .16s,background .16s}
  .play:hover{transform:scale(1.08)}
  .play:disabled{cursor:not-allowed;background:#9FB0BC}
  .play svg{fill:currentColor;grid-area:1/1}
  .i-pause,.i-load{display:none}
  .player.playing .i-play{display:none}
  .player.playing .i-pause{display:block}
  .player.loading .i-play,.player.loading .i-pause{display:none}
  .player.loading .i-load{display:block;fill:none;stroke:currentColor;stroke-width:2.5;
    stroke-dasharray:44;stroke-dashoffset:14;animation:spin .8s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}

  /* ---------------- full ---------------- */
  .player:not(.compact){display:flex;align-items:center;gap:16px;
    background:color-mix(in srgb, var(--accent) 7%, #fff);
    border:1px solid color-mix(in srgb, var(--accent) 22%, #fff);
    border-radius:999px;padding:10px 22px 10px 10px;margin-bottom:10px}
  .player:not(.compact) .play{width:50px;height:50px}
  .player:not(.compact) .play svg{width:22px;height:22px}
  .body{flex:1;min-width:0}
  .top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:7px}
  .lbl{font-family:var(--head);font-size:.68rem;font-weight:700;letter-spacing:.16em;
       text-transform:uppercase;color:var(--accent)}
  .time{font-family:var(--head);font-size:.75rem;color:var(--slate);
        font-variant-numeric:tabular-nums;white-space:nowrap}
  .track{position:relative;height:30px;cursor:pointer;display:flex;align-items:center}
  .wave{position:absolute;inset:0;display:flex;align-items:center;gap:2px;pointer-events:none}
  .wave span{flex:1;background:color-mix(in srgb, var(--accent) 26%, #fff);border-radius:1px;min-height:3px}
  .bar{position:absolute;left:0;top:0;bottom:0;width:0%;background:var(--accent);
       opacity:.26;border-radius:4px;transition:width .1s linear;pointer-events:none}
  .player.missing:not(.compact){background:#F6F8FA;border-color:var(--line)}
  .missing .lbl{color:#8A5B10}

  /* ---------------- compact: overlays the artwork ---------------- */
  /* Covers the art but stays out of its way: control cluster top-right,
     progress pinned to the very bottom edge. No scrim over the logo. */
  .player.compact{position:absolute;inset:0;z-index:2;pointer-events:none;
    display:flex;align-items:flex-start;justify-content:flex-end;gap:0;padding:14px}
  .player.compact .play{width:52px;height:52px;pointer-events:auto;
    box-shadow:0 8px 22px -6px rgba(0,0,0,.6), 0 0 0 4px rgba(255,255,255,.22)}
  .player.compact .play svg{width:23px;height:23px}

  .c-label{position:absolute;top:22px;right:78px;pointer-events:none;
    font-family:var(--head);font-size:.7rem;font-weight:700;letter-spacing:.07em;
    text-transform:uppercase;color:#fff;background:rgba(8,16,22,.6);
    backdrop-filter:blur(6px);padding:6px 12px;border-radius:999px;white-space:nowrap;
    opacity:0;transform:translateX(6px);transition:opacity .2s,transform .2s}
  .tc:hover .c-label,.player.compact.playing .c-label{opacity:1;transform:none}

  .player.compact .time{position:absolute;bottom:14px;right:14px;pointer-events:none;
    font-size:.72rem;color:#fff;background:rgba(8,16,22,.6);backdrop-filter:blur(6px);
    padding:4px 10px;border-radius:999px}
  .player.compact .time:empty{display:none}

  .c-track{position:absolute;left:0;right:0;bottom:0;height:14px;cursor:pointer;
           pointer-events:auto;z-index:3}
  .c-bar-wrap{position:absolute;left:0;right:0;bottom:0;height:5px;
              background:rgba(255,255,255,.26)}
  .c-bar{height:100%;width:0%;background:var(--accent);transition:width .1s linear}
  .player.compact.missing .play{background:rgba(255,255,255,.4);box-shadow:none}
  .player.compact.missing .c-label{opacity:1;transform:none;color:#FFD79A}
</style>

<script>
  const players = document.querySelectorAll<HTMLElement>('[data-player]');

  players.forEach((p) => {
    if (p.dataset.unavailable === "true") return;
    const audio = p.querySelector('audio') as HTMLAudioElement;
    const btn = p.querySelector('[data-play]') as HTMLButtonElement;
    const bar = p.querySelector('[data-bar]') as HTMLElement | null;
    const time = p.querySelector('[data-time]') as HTMLElement | null;
    const track = p.querySelector('[data-track]') as HTMLElement | null;
    const lbl = p.querySelector('[data-label]') as HTMLElement | null;

    const fmt = (s: number) =>
      !isFinite(s) ? '' : `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    let stall: ReturnType<typeof setTimeout> | undefined;
    const markMissing = () => {
      clearTimeout(stall);
      p.classList.add('missing');
      p.classList.remove('loading', 'playing');
      btn.disabled = true;
      if (lbl) lbl.textContent = 'Demo coming soon';
      if (time) time.textContent = '';
    };
    audio.addEventListener('error', markMissing);
    audio.addEventListener('stalled', markMissing);
    const armStall = () => { clearTimeout(stall); stall = setTimeout(markMissing, 4000); };

    btn.addEventListener('click', () => {
      if (audio.paused) {
        document.querySelectorAll('audio').forEach((a) => { if (a !== audio) a.pause(); });
        players.forEach((o) => o !== p && o.classList.remove('playing'));
        p.classList.add('loading');
        armStall();
        audio.play().catch(markMissing);
      } else {
        audio.pause();
      }
    });

    audio.addEventListener('playing', () => { clearTimeout(stall); p.classList.remove('loading'); });
    audio.addEventListener('play', () => p.classList.add('playing'));
    audio.addEventListener('pause', () => p.classList.remove('playing', 'loading'));
    audio.addEventListener('ended', () => {
      p.classList.remove('playing');
      if (bar) bar.style.width = '0%';
      if (time) time.textContent = fmt(audio.duration);
    });
    audio.addEventListener('loadedmetadata', () => { if (time) time.textContent = fmt(audio.duration); });
    audio.addEventListener('timeupdate', () => {
      const pct = (audio.currentTime / audio.duration) * 100;
      if (bar) bar.style.width = `${pct || 0}%`;
      if (time) time.textContent = fmt(audio.duration - audio.currentTime);
      track?.setAttribute('aria-valuenow', String(Math.round(pct || 0)));
    });

    const seek = (clientX: number) => {
      if (!audio.duration || !track) return;
      const r = track.getBoundingClientRect();
      audio.currentTime = Math.min(Math.max((clientX - r.left) / r.width, 0), 1) * audio.duration;
    };
    track?.addEventListener('click', (e) => seek((e as MouseEvent).clientX));
    track?.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'ArrowRight') { audio.currentTime = Math.min(audio.currentTime + 5, audio.duration); e.preventDefault(); }
      if (k === 'ArrowLeft') { audio.currentTime = Math.max(audio.currentTime - 5, 0); e.preventDefault(); }
    });
  });
</script>
